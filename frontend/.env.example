VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=true

# Credentials for privileged recovery actions (approve & apply). The API derives the audit
# actor from these, ignoring the request body.
#
# WARNING: every VITE_ variable is inlined into the public JavaScript bundle at build time.
# Anyone who loads the dashboard can read VITE_RECOVERY_API_KEY. Leave it blank unless the
# key is genuinely low-value, and prefer running the API with
# DRIFTZERO_RECOVERY_ALLOW_LOCAL_IDENTITY=true, which needs no key at all. That is what the
# local stack and the Render deployment both do.
VITE_RECOVERY_API_KEY=
# High-risk recovery plans require the admin role; operator covers low and medium risk.
VITE_RECOVERY_ACTOR=dashboard-operator
VITE_RECOVERY_ROLE=operator
