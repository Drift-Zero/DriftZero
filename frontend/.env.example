VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_DEMO_MODE=true

# Credentials for privileged recovery actions (approve & apply). The API derives the audit
# actor from these, ignoring the request body. Leave the key blank against a local or demo
# backend running with DRIFTZERO_RECOVERY_ALLOW_LOCAL_IDENTITY=true; set it to the backend's
# DRIFTZERO_RECOVERY_OPERATOR_API_KEY (or the admin key, which high-risk plans require)
# anywhere local identity is disabled.
VITE_RECOVERY_API_KEY=
VITE_RECOVERY_ACTOR=dashboard-operator
VITE_RECOVERY_ROLE=operator
