DRIFTZERO_DATABASE_URL=sqlite:///./driftzero.db
DRIFTZERO_API_PREFIX=/api/v1
DRIFTZERO_ENVIRONMENT=development
DRIFTZERO_MINIMUM_SAMPLE_SIZE=20
DRIFTZERO_MINIMUM_COVERAGE=0.30
DRIFTZERO_FORECAST_HORIZON_MINUTES=30
# Polling interval for `python -m app.alert_worker`.
DRIFTZERO_ALERT_EVALUATION_INTERVAL_SECONDS=60
# Durable recovery command worker settings.
DRIFTZERO_RECOVERY_WORKER_INTERVAL_SECONDS=2
DRIFTZERO_RECOVERY_COMMAND_LEASE_SECONDS=60
DRIFTZERO_RECOVERY_COMMAND_MAX_ATTEMPTS=3
# Polling interval for trace retention enforcement.
DRIFTZERO_RETENTION_INTERVAL_SECONDS=3600
DRIFTZERO_LOG_LEVEL=INFO
# Optional rotating JSON log file. Stdout JSON logging is always enabled.
# DRIFTZERO_LOG_FILE=./logs/driftzero.jsonl
DRIFTZERO_LOG_FILE_MAX_BYTES=10485760
DRIFTZERO_LOG_FILE_BACKUP_COUNT=5
DRIFTZERO_SLOW_QUERY_MS=250
DRIFTZERO_OTEL_ENABLED=false
DRIFTZERO_OTEL_SERVICE_NAME=driftzero-api
# Optional directory of static dashboard files for a single-container deployment.
# DRIFTZERO_FRONTEND_DIR=/app/frontend
# Used by the optional OpenTelemetry OTLP HTTP exporter.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
