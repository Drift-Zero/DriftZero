# Local ports
DRIFTZERO_DASHBOARD_PORT=3000
DRIFTZERO_API_PORT=8000

# Backend runtime. Keep the four-slash SQLite URL inside Docker.
DRIFTZERO_DATABASE_URL=sqlite:////data/driftzero.db
DRIFTZERO_API_PREFIX=/api/v1
DRIFTZERO_ENVIRONMENT=development
DRIFTZERO_MINIMUM_SAMPLE_SIZE=20
DRIFTZERO_MINIMUM_COVERAGE=0.30
DRIFTZERO_FORECAST_HORIZON_MINUTES=30
DRIFTZERO_ALERT_EVALUATION_INTERVAL_SECONDS=60
DRIFTZERO_RECOVERY_WORKER_INTERVAL_SECONDS=2
DRIFTZERO_RECOVERY_COMMAND_LEASE_SECONDS=60
DRIFTZERO_RECOVERY_COMMAND_MAX_ATTEMPTS=3
DRIFTZERO_RETENTION_INTERVAL_SECONDS=3600
DRIFTZERO_LOG_LEVEL=INFO
DRIFTZERO_SLOW_QUERY_MS=250
DRIFTZERO_OTEL_ENABLED=false
DRIFTZERO_OTEL_SERVICE_NAME=driftzero-api

# Optional OpenTelemetry collector
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
