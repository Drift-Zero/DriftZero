# Server-side DriftZero delivery. ShopAssist sends each complete 20-interaction
# raw window to DriftZero for approved-evidence evaluation.
DRIFTZERO_API_URL=http://127.0.0.1:8000
# Optional explicit target. When omitted, the server resolves the unique model
# named ShopAssist through DriftZero's models API.
DRIFTZERO_MODEL_ID=
# Required only when the target model has a protected telemetry connection.
DRIFTZERO_INGEST_KEY=
SHOPASSIST_PUBLIC_URL=http://localhost:3000

# Server-side only. Set real values in .env.local; never commit credentials.
GROQ_API_KEY=
GEMINI_API_KEY=
