# Optional DriftZero telemetry delivery. Without these values, traces are buffered
# in sessionStorage so the deterministic demo remains usable offline.
NEXT_PUBLIC_DRIFTZERO_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_DRIFTZERO_MODEL_ID=

# Server-side only. Never expose these values with a NEXT_PUBLIC_ prefix.
GROQ_API_KEY=
GEMINI_API_KEY=
